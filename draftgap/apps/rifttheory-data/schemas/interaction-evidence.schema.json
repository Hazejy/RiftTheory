{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rifttheory.app/schemas/interaction-evidence.schema.json",
  "title": "RiftTheory interaction evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources", "profiles", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "kind", "accessNote"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$" },
          "label": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["official", "manual", "ai_assisted", "historical"]
          },
          "url": { "type": ["string", "null"], "format": "uri" },
          "accessNote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "champion",
          "role",
          "patch",
          "assessmentMethod",
          "reviewStatus",
          "sourceKey",
          "traits"
        ],
        "properties": {
          "champion": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [{ "required": ["riotKey"] }, { "required": ["name"] }],
            "properties": {
              "riotKey": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            }
          },
          "role": { "enum": ["top", "jungle", "mid", "bot", "support"] },
          "patch": {
            "type": ["string", "null"],
            "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
          },
          "assessmentMethod": {
            "enum": ["manual", "ai_assisted", "observed", "hybrid"]
          },
          "reviewStatus": {
            "enum": ["unreviewed", "provisional", "reviewed", "outdated"]
          },
          "sourceKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          },
          "traits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["trait", "level", "reasoning"],
              "properties": {
                "trait": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "level": { "type": "integer", "minimum": 1, "maximum": 5 },
                "confidence": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 1
                },
                "reasoning": { "type": "string", "minLength": 1 },
                "conditions": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleKey",
          "subjectTrait",
          "objectTrait",
          "comparison",
          "subjectMinimum",
          "objectMinimum",
          "minimumDifference",
          "relation",
          "severity",
          "condition",
          "effect",
          "patch",
          "confidence",
          "reviewStatus",
          "sourceKey"
        ],
        "properties": {
          "ruleKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$" },
          "subjectTrait": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "objectTrait": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "comparison": { "enum": ["subject_greater", "both_at_least"] },
          "subjectMinimum": { "type": "integer", "minimum": 1, "maximum": 5 },
          "objectMinimum": { "type": "integer", "minimum": 1, "maximum": 5 },
          "minimumDifference": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "relation": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "severity": { "enum": ["note", "warning", "strong"] },
          "condition": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 },
          "patch": {
            "type": ["string", "null"],
            "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
          },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "reviewStatus": {
            "enum": ["unreviewed", "provisional", "reviewed", "outdated"]
          },
          "sourceKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$" }
        }
      }
    }
  }
}
