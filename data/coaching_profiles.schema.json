{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rifttheory.local/schemas/coaching_profiles.schema.json",
  "title": "RiftTheory role-specific coaching profiles",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "champion_name",
      "role",
      "damage_focus",
      "power_curve",
      "resource_demand",
      "execution_demand",
      "spike_notes",
      "reasoning",
      "patch",
      "assessment_method",
      "confidence",
      "review_status",
      "source_name"
    ],
    "properties": {
      "champion_name": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string",
        "enum": ["top", "jungle", "mid", "bot", "support"]
      },
      "damage_focus": {
        "type": "string",
        "enum": ["physical", "magic", "mixed", "utility", "build_dependent"]
      },
      "power_curve": {
        "type": "string",
        "enum": ["early", "early_mid", "mid", "mid_late", "late", "timing_dependent"]
      },
      "resource_demand": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "execution_demand": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "spike_notes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "reasoning": {
        "type": "string",
        "minLength": 1
      },
      "patch": {
        "type": "string",
        "minLength": 1
      },
      "assessment_method": {
        "type": "string",
        "enum": ["manual", "editorial", "observed", "hybrid"]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "review_status": {
        "type": "string",
        "enum": ["provisional", "reviewed", "deprecated"]
      },
      "source_name": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
