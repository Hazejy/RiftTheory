{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rifttheory.app/schemas/role-observations.schema.json",
  "title": "RiftTheory role observation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "context", "observations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "accessNote"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$" },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "accessNote": { "type": "string", "minLength": 1 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "region", "rankBracket", "queue", "observedAt"],
      "properties": {
        "patch": { "type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$" },
        "region": { "type": "string", "minLength": 1 },
        "rankBracket": { "type": "string", "minLength": 1 },
        "queue": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["champion", "role", "games"],
        "properties": {
          "champion": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [{ "required": ["riotKey"] }, { "required": ["name"] }],
            "properties": {
              "riotKey": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            }
          },
          "role": { "enum": ["top", "jungle", "mid", "bot", "support"] },
          "games": { "type": "integer", "minimum": 1 },
          "wins": { "type": ["integer", "null"], "minimum": 0 },
          "pickRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
